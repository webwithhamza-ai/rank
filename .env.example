# =============================================================================
# [YOUR_SITE_NAME] — environment
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# mock | testnet | mainnet
APP_MODE=mock
# Same value, exposed to the browser so the mode banner can render.
NEXT_PUBLIC_APP_MODE=mock

# mock | x
# mock  = dev login page, type any handle.
# x     = real X (Twitter) OAuth 2.0. Required when APP_MODE=mainnet.
AUTH_MODE=mock

# Shown in the header, page titles and share text.
NEXT_PUBLIC_SITE_NAME=[YOUR_SITE_NAME]

# Public origin of the deployment (used for share links and OAuth callbacks).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Local:      docker compose up -d   ->  the URL below works as-is
# Production: Neon / Supabase connection string (add ?sslmode=require)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paytorank

# -----------------------------------------------------------------------------
# Auth
# Generate a secret with:  openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-long-random-string
# Real X OAuth 2.0 app credentials (https://developer.x.com).
# Callback URL to register: <NEXT_PUBLIC_BASE_URL>/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Comma-separated X user IDs (numeric) allowed into /admin.
# In mock auth mode the mock id is "mock:<handle>", e.g. ADMIN_X_IDS=mock:admin
ADMIN_X_IDS=mock:admin

# Salt used to hash visitor IPs before storing them (click + report dedupe).
IP_HASH_SALT=change-me

# -----------------------------------------------------------------------------
# Deposit wallet
# The server only ever knows the EXTENDED PUBLIC KEY. It cannot spend.
# Generate with:  pnpm wallet:generate   (run on your own machine, offline)
# Keep the mnemonic OFFLINE. See SECURITY.md.
# -----------------------------------------------------------------------------
DEPOSIT_XPUB=
# Where swept funds go. Used only by scripts/sweep.ts, which runs locally.
TREASURY_ADDRESS=

# -----------------------------------------------------------------------------
# Chains & tokens
#
# !! VERIFY EVERY ADDRESS BELOW FROM THE OFFICIAL SOURCE BEFORE MAINNET !!
#   USDC   -> https://developers.circle.com/stablecoins/usdc-contract-addresses
#   USDG   -> Paxos / Global Dollar docs, and https://docs.robinhood.com/chain
#   Chain  -> https://docs.robinhood.com/chain
#
# Leave a token address blank to hide that chain/token option in the UI.
# -----------------------------------------------------------------------------

# --- Base ---
# mainnet 8453 | sepolia 84532
BASE_CHAIN_ID=8453
# Public RPCs are rate limited. Use a paid endpoint (Alchemy/Infura/QuickNode)
# in production or the watcher will fall behind.
BASE_RPC_URL=https://mainnet.base.org
BASE_EXPLORER_URL=https://basescan.org
# VERIFY: Circle's official USDC on Base.
BASE_USDC_ADDRESS=
# VERIFY: USDG on Base. If USDG is not deployed on Base, leave this BLANK and
# the Base+USDG option disappears from the UI automatically.
BASE_USDG_ADDRESS=
BASE_CONFIRMATIONS=3

# --- Robinhood Chain ---
# mainnet 4663 | testnet 46630
RHC_CHAIN_ID=4663
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# VERIFY: USDG on Robinhood Chain.
RHC_USDG_ADDRESS=
# VERIFY: USDC on Robinhood Chain. If it does not exist, leave BLANK to hide.
RHC_USDC_ADDRESS=
RHC_CONFIRMATIONS=3

# -----------------------------------------------------------------------------
# Watcher tuning
# -----------------------------------------------------------------------------
# Blocks scanned per getLogs call. Lower it if your RPC rejects wide ranges.
WATCHER_BATCH_BLOCKS=2000
WATCHER_POLL_MS=12000
# Secret for the cron-triggered watcher route (POST /api/cron/watch).
CRON_SECRET=

# -----------------------------------------------------------------------------
# Checkout tuning
# -----------------------------------------------------------------------------
CHECKOUT_TTL_MINUTES=30
# Keep watching expired deposit addresses this long so late payments still land.
DEPOSIT_WATCH_DAYS=7
